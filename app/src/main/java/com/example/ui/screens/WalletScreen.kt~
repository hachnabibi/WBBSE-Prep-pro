data class WalletTransaction(
    val id: String = "",
    val title: String = "",
    val amount: Int = 0, // Positive for earned, negative for spent
    val isCredit: Boolean = true,
    val timestamp: Long = System.currentTimeMillis(),
    val category: String = "REWARD"
)

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun WalletScreen(
    viewModel: DeshExamViewModel,
    isBengali: Boolean,
    onBack: () -> Unit,
    modifier: Modifier = Modifier
) {
    val profile by viewModel.studentProfile.collectAsState()
    val currentTokens = profile.coins

    var selectedTab by remember { mutableIntStateOf(0) } // 0 = Earn, 1 = Redeem, 2 = Transactions
    var actionMessage by remember { mutableStateOf<String?>(null) }
    var isSuccessMessage by remember { mutableStateOf(true) }

    // Mock transaction history if Firestore is empty
    var transactions by remember {
        mutableStateOf(
            listOf(
                WalletTransaction("tx_1", if (isBengali) "দৈনিক লগইন রিওয়ার্ড" else "Daily Login Bonus", +50, true, System.currentTimeMillis() - 3600000, "DAILY"),
                WalletTransaction("tx_2", if (isBengali) "মক টেস্ট সম্পন্ন বোনাস" else "Mock Test Completion", +100, true, System.currentTimeMillis() - 86400000, "TEST"),
                WalletTransaction("tx_3", if (isBengali) "এআই কোচ সাজেশন আনলক" else "Unlocked AI Coach Insights", -150, false, System.currentTimeMillis() - 172800000, "REDEEM")
            )
        )
    }

    val dateFormat = remember { SimpleDateFormat("dd MMM, hh:mm a", Locale.getDefault()) }

    fun addTransaction(title: String, amount: Int, isCredit: Boolean, category: String) {
        val newTx = WalletTransaction(
            id = "tx_${System.currentTimeMillis()}",
            title = title,
            amount = amount,
            isCredit = isCredit,
            timestamp = System.currentTimeMillis(),
            category = category
        )
        transactions = listOf(newTx) + transactions

        // Update profile in ViewModel
        val updatedCoins = if (isCredit) currentTokens + amount else (currentTokens - amount).coerceAtLeast(0)
        viewModel.updateStudentProfile(profile.copy(coins = updatedCoins))

        actionMessage = if (isCredit) {
            if (isBengali) "🎉 +$amount কয়েন ওয়ালেটে যোগ হয়েছে!" else "🎉 +$amount Coins added to wallet!"
        } else {
            if (isBengali) "✅ $amount কয়েন রিডিম করা হয়েছে!" else "✅ $amount Coins redeemed successfully!"
        }
        isSuccessMessage = true
    }

    Scaffold(
        modifier = modifier
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
                .padding(horizontal = 16.dp),
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {
            // Hero Token Balance Card
            Card(
                shape = RoundedCornerShape(20.dp),
                colors = CardDefaults.cardColors(containerColor = Color.Transparent),
                modifier = Modifier
                    .fillMaxWidth()
                    .background(
                        brush = Brush.horizontalGradient(
                            colors = listOf(PrimaryIndigo, Color(0xFF3F51B5), Color(0xFF1A237E))
                        ),
                        shape = RoundedCornerShape(20.dp)
                    )
            ) {
                Column(
                    modifier = Modifier.padding(20.dp),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Column {
                            Text(
                                text = if (isBengali) "বর্তমান ব্যালেন্স" else "CURRENT BALANCE",
                                style = MaterialTheme.typography.labelSmall.copy(letterSpacing = 1.sp),
                                color = Color.White.copy(alpha = 0.8f)
                            )
                            Spacer(modifier = Modifier.height(4.dp))
                            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                                Text(
                                    text = "🪙 $currentTokens",
                                    style = MaterialTheme.typography.headlineLarge.copy(fontWeight = FontWeight.Black),
                                    color = ExamGold
                                )
                                Text(
                                    text = if (isBengali) "কয়েন (Coins)" else "Coins",
                                    style = MaterialTheme.typography.titleMedium,
                                    color = Color.White.copy(alpha = 0.9f)
                                )
                            }
                        }

                        // Badge Level
                        Surface(
                            shape = RoundedCornerShape(12.dp),
                            color = ExamGold.copy(alpha = 0.25f),
                            border = BorderStroke(1.dp, ExamGold)
                        ) {
                            Row(
                                modifier = Modifier.padding(horizontal = 10.dp, vertical = 6.dp),
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(4.dp)
                            ) {
                                Icon(Icons.Default.EmojiEvents, contentDescription = null, tint = ExamGold, modifier = Modifier.size(16.dp))
                                Text(
                                    text = if (isBengali) "গোল্ড মেম্বার" else "Gold Rank",
                                    style = MaterialTheme.typography.labelSmall.copy(fontWeight = FontWeight.Bold),
                                    color = ExamGold
                                )
                            }
                        }
                    }

                    HorizontalDivider(color = Color.White.copy(alpha = 0.2f))

                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween
                    ) {
                        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                            Icon(Icons.Default.VerifiedUser, contentDescription = null, tint = CorrectGreen, modifier = Modifier.size(16.dp))
                            Text(
                                text = if (isBengali) "১০০% সেফ ও সিকিউর ফায়ারবেস ওয়ালেট" else "Secure Firebase Wallet",
                                style = MaterialTheme.typography.labelSmall,
                                color = Color.White.copy(alpha = 0.85f)
                            )
                        }
                        Text(
                            text = if (isBengali) "ইউজার: ${profile.name}" else "User: ${profile.name}",
                            style = MaterialTheme.typography.labelSmall,
                            color = Color.White.copy(alpha = 0.6f)
                        )
                    }
                }
            }

            // Status message
            actionMessage?.let { msg ->
                Surface(
                    shape = RoundedCornerShape(12.dp),
                    color = CorrectGreen.copy(alpha = 0.15f),
                    border = BorderStroke(1.dp, CorrectGreen),
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Row(
                        modifier = Modifier.padding(12.dp),
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Icon(Icons.Default.CheckCircle, contentDescription = null, tint = CorrectGreen)
                        Text(
                            text = msg,
                            style = MaterialTheme.typography.bodySmall.copy(fontWeight = FontWeight.Bold),
                            color = MaterialTheme.colorScheme.onSurface,
                            modifier = Modifier.weight(1f)
                        )
                        IconButton(onClick = { actionMessage = null }, modifier = Modifier.size(24.dp)) {
                            Icon(Icons.Default.Close, contentDescription = "Dismiss", modifier = Modifier.size(16.dp))
                        }
                    }
                }
            }

            // Tab Switcher
            TabRow(
                selectedTabIndex = selectedTab,
                containerColor = MaterialTheme.colorScheme.surfaceVariant,
                contentColor = ExamGold,
                modifier = Modifier.clip(RoundedCornerShape(12.dp))
            ) {
                Tab(
                    selected = selectedTab == 0,
                    onClick = { selectedTab = 0 },
                    text = { Text(if (isBengali) "🎯 আয় করুন (Earn)" else "Earn", fontSize = 12.sp, fontWeight = FontWeight.Bold) }
                )
                Tab(
                    selected = selectedTab == 1,
                    onClick = { selectedTab = 1 },
                    text = { Text(if (isBengali) "🎁 রিডিম করুন (Redeem)" else "Redeem", fontSize = 12.sp, fontWeight = FontWeight.Bold) }
                )
                Tab(
                    selected = selectedTab == 2,
                    onClick = { selectedTab = 2 },
                    text = { Text(if (isBengali) "📜 হিস্ট্রি (History)" else "History", fontSize = 12.sp, fontWeight = FontWeight.Bold) }
                )
            }

            // Tab Content
            when (selectedTab) {
                0 -> {
                    // Earn Coins Section
                    LazyColumn(
                        modifier = Modifier
                            .fillMaxWidth()
                            .weight(1f),
                        verticalArrangement = Arrangement.spacedBy(10.dp)
                    ) {
                        item {
                            EarnTaskCard(
                                title = if (isBengali) "দৈনিক লগইন বোনাস" else "Daily Check-in Reward",
                                reward = "+৫০ কয়েন",
                                description = if (isBengali) "প্রতিদিন অ্যাপে লগইন করে ফ্রি কয়েন ক্লেইম করুন" else "Claim free coins every day by opening the app",
                                icon = Icons.Default.CalendarToday,
                                isBengali = isBengali,
                                onClaim = {
                                    addTransaction(
                                        title = if (isBengali) "দৈনিক বোনাস" else "Daily Check-in Bonus",
                                        amount = 50,
                                        isCredit = true,
                                        category = "DAILY"
                                    )
                                }
                            )
                        }

                        item {
                            EarnTaskCard(
                                title = if (isBengali) "মক টেস্ট সম্পূর্ণ করুন" else "Complete a Mock Test",
                                reward = "+১০০ কয়েন",
                                description = if (isBengali) "যেকোনো বিষয়ে একটি পূর্ণাঙ্গ মক টেস্ট শেষ করুন" else "Finish any full mock test with 80%+ score",
                                icon = Icons.Default.AssignmentTurnedIn,
                                isBengali = isBengali,
                                onClaim = {
                                    addTransaction(
                                        title = if (isBengali) "মক টেস্ট পুরস্কার" else "Mock Test Achievement",
                                        amount = 100,
                                        isCredit = true,
                                        category = "TEST"
                                    )
                                }
                            )
                        }

                        item {
                            EarnTaskCard(
                                title = if (isBengali) "১০টি প্র্যাকটিস প্রশ্ন সমাধান" else "Solve 10 Practice Questions",
                                reward = "+৩০ কয়েন",
                                description = if (isBengali) "অধ্যায়ভিত্তিক প্র্যাকটিস মোডে ১০টি প্রশ্নের সঠিক উত্তর দিন" else "Answer 10 practice questions correctly",
                                icon = Icons.Default.Quiz,
                                isBengali = isBengali,
                                onClaim = {
                                    addTransaction(
                                        title = if (isBengali) "১০টি প্রশ্ন সমাধান বোনাস" else "Practice Mastery Bonus",
                                        amount = 30,
                                        isCredit = true,
                                        category = "PRACTICE"
                                    )
                                }
                            )
                        }

                        item {
                            EarnTaskCard(
                                title = if (isBengali) "বন্ধুকে ইনভাইট করুন (Referral)" else "Invite a Friend (Referral)",
                                reward = "+২০০ কয়েন",
                                description = if (isBengali) "আপনার ইনভাইট লিংক শেয়ার করে সহপাঠীকে যুক্ত করুন" else "Share invite link with classmates to earn coins",
                                icon = Icons.Default.Share,
                                isBengali = isBengali,
                                onClaim = {
                                    addTransaction(
                                        title = if (isBengali) "ফ্রেন্ড রেফারাল রিওয়ার্ড" else "Friend Referral Bonus",
                                        amount = 200,
                                        isCredit = true,
                                        category = "REFERRAL"
                                    )
                                }
                            )
                        }
                    }
                }

                1 -> {
                    // Redeem Rewards Section
                    LazyColumn(
                        modifier = Modifier
                            .fillMaxWidth()
                            .weight(1f),
                        verticalArrangement = Arrangement.spacedBy(10.dp)
                    ) {
                        item {
                            RedeemCard(
                                title = if (isBengali) "প্রিমিয়াম সাজেশন ও নোটস আনলক" else "Unlock Premium Model Notes",
                                cost = 300,
                                currentTokens = currentTokens,
                                description = if (isBengali) "স্পেশাল সাজেস্টিভ প্রশ্নাবলী আনলক করুন" else "Get access to suggestive papers",
                                icon = Icons.AutoMirrored.Filled.MenuBook,
                                isBengali = isBengali,
                                onRedeem = {
                                    addTransaction(
                                        title = if (isBengali) "প্রিমিয়াম নোটস আনলক" else "Unlocked Premium Notes",
                                        amount = 300,
                                        isCredit = false,
                                        category = "REDEEM"
                                    )
                                }
                            )
                        }

                        item {
                            RedeemCard(
                                title = if (isBengali) "এআই কোচ আনলিমিটেড টিপস" else "AI Coach Unlimited Suggestions",
                                cost = 500,
                                currentTokens = currentTokens,
                                description = if (isBengali) "আপনার দুর্বলতা কাটিয়ে ওঠার জন্য AI পার্সোনালাইজড প্ল্যান" else "Unlimited AI study plans tailored for your weaknesses",
                                icon = Icons.Default.AutoAwesome,
                                isBengali = isBengali,
                                onRedeem = {
                                    addTransaction(
                                        title = if (isBengali) "AI কোচ প্রিমিয়াম আনলক" else "Unlocked AI Coach Premium",
                                        amount = 500,
                                        isCredit = false,
                                        category = "REDEEM"
                                    )
                                }
                            )
                        }

                        item {
                            RedeemCard(
                                title = if (isBengali) "পেইড টেস্ট সিরিজ ৫০ টাকা ডিসকাউন্ট কুপন" else "₹50 Discount Coupon on Test Series",
                                cost = 1000,
                                currentTokens = currentTokens,
                                description = if (isBengali) "যেকোনো পেইড মক টেস্ট সিজনে ৫০ টাকা ছাড় পান" else "Get ₹50 discount voucher for Razorpay checkout",
                                icon = Icons.Default.LocalOffer,
                                isBengali = isBengali,
                                onRedeem = {
                                    addTransaction(
                                        title = if (isBengali) "৫০ টাকা ডিসকাউন্ট কুপন" else "Redeemed ₹50 Voucher",
                                        amount = 1000,
                                        isCredit = false,
                                        category = "COUPON"
                                    )
                                }
                            )
                        }
                    }
                }

                2 -> {
                    // Transaction History
                    if (transactions.isEmpty()) {
                        Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                            Text(
                                text = if (isBengali) "কোনো ট্রানজ্যাকশন হিস্ট্রি পাওয়া যায়নি" else "No transactions yet",
                                style = MaterialTheme.typography.bodyMedium,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                    } else {
                        LazyColumn(
                            modifier = Modifier
                                .fillMaxWidth()
                                .weight(1f),
                            verticalArrangement = Arrangement.spacedBy(8.dp)
                        ) {
                            items(transactions) { tx ->
                                Card(
                                    shape = RoundedCornerShape(12.dp),
                                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
                                    border = BorderStroke(1.dp, MaterialTheme.colorScheme.surfaceVariant),
                                    modifier = Modifier.fillMaxWidth()
                                ) {
                                    Row(
                                        modifier = Modifier.padding(14.dp),
                                        verticalAlignment = Alignment.CenterVertically,
                                        horizontalArrangement = Arrangement.spacedBy(12.dp)
                                    ) {
                                        Surface(
                                            shape = CircleShape,
                                            color = if (tx.isCredit) CorrectGreen.copy(alpha = 0.15f) else WrongRed.copy(alpha = 0.15f),
                                            modifier = Modifier.size(40.dp)
                                        ) {
                                            Box(contentAlignment = Alignment.Center) {
                                                Icon(
                                                    imageVector = if (tx.isCredit) Icons.Default.AddCircle else Icons.Default.RemoveCircle,
                                                    contentDescription = null,
                                                    tint = if (tx.isCredit) CorrectGreen else WrongRed,
                                                    modifier = Modifier.size(20.dp)
                                                )
                                            }
                                        }

                                        Column(modifier = Modifier.weight(1f)) {
                                            Text(
                                                text = tx.title,
                                                style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Bold),
                                                color = MaterialTheme.colorScheme.onSurface
                                            )
                                            Text(
                                                text = dateFormat.format(Date(tx.timestamp)),
                                                style = MaterialTheme.typography.labelSmall,
                                                color = MaterialTheme.colorScheme.onSurfaceVariant
                                            )
                                        }

                                        Text(
                                            text = "${if (tx.isCredit) "+" else "-"}${kotlin.math.abs(tx.amount)} 🪙",
                                            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Black),
                                            color = if (tx.isCredit) CorrectGreen else WrongRed
                                        )
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

@Composable
private fun EarnTaskCard(
    title: String,
    reward: String,
    description: String,
    icon: androidx.compose.ui.graphics.vector.ImageVector,
    isBengali: Boolean,
    onClaim: () -> Unit
) {
    Card(
        shape = RoundedCornerShape(14.dp),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
        border = BorderStroke(1.dp, MaterialTheme.colorScheme.surfaceVariant),
        modifier = Modifier.fillMaxWidth()
    ) {
        Row(
            modifier = Modifier.padding(16.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(14.dp)
        ) {
            Surface(
                shape = RoundedCornerShape(12.dp),
                color = ExamGold.copy(alpha = 0.15f),
                modifier = Modifier.size(44.dp)
            ) {
                Box(contentAlignment = Alignment.Center) {
                    Icon(icon, contentDescription = null, tint = ExamGold)
                }
            }

            Column(modifier = Modifier.weight(1f)) {
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(6.dp)
                ) {
                    Text(
                        text = title,
                        style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.Bold),
                        color = MaterialTheme.colorScheme.onSurface
                    )
                }
                Spacer(modifier = Modifier.height(2.dp))
                Text(
                    text = description,
                    style = MaterialTheme.typography.bodySmall,
                    color = MaterialTheme.colorScheme.onSurfaceVariant
                )
            }

            Button(
                onClick = onClaim,
                colors = ButtonDefaults.buttonColors(containerColor = ExamGold, contentColor = Color(0xFF1E1B2E)),
                shape = RoundedCornerShape(10.dp),
                contentPadding = PaddingValues(horizontal = 12.dp, vertical = 6.dp)
            ) {
                Text(
                    text = reward,
                    fontWeight = FontWeight.Black,
                    fontSize = 12.sp
                )
            }
        }
    }
}

@Composable
private fun RedeemCard(
    title: String,
    cost: Int,
    currentTokens: Int,
    description: String,
    icon: androidx.compose.ui.graphics.vector.ImageVector,
    isBengali: Boolean,
    onRedeem: () -> Unit
) {
    val canAfford = currentTokens >= cost

    Card(
        shape = RoundedCornerShape(14.dp),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
        border = BorderStroke(1.dp, if (canAfford) ExamGold.copy(alpha = 0.5f) else MaterialTheme.colorScheme.surfaceVariant),
        modifier = Modifier.fillMaxWidth()
    ) {
        Row(
            modifier = Modifier.padding(16.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(14.dp)
        ) {
            Surface(
                shape = RoundedCornerShape(12.dp),
                color = PrimaryIndigo.copy(alpha = 0.15f),
                modifier = Modifier.size(44.dp)
            ) {
                Box(contentAlignment = Alignment.Center) {
                    Icon(icon, contentDescription = null, tint = PrimaryIndigo)
                }
            }

            Column(modifier = Modifier.weight(1f)) {
                Text(
                    text = title,
                    style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.Bold),
                    color = MaterialTheme.colorScheme.onSurface
                )
                Spacer(modifier = Modifier.height(2.dp))
                Text(
                    text = description,
                    style = MaterialTheme.typography.bodySmall,
                    color = MaterialTheme.colorScheme.onSurfaceVariant
                )
            }

            Button(
                onClick = onRedeem,
                enabled = canAfford,
                colors = ButtonDefaults.buttonColors(
                    containerColor = PrimaryIndigo,
                    disabledContainerColor = MaterialTheme.colorScheme.surfaceVariant
                ),
                shape = RoundedCornerShape(10.dp),
                contentPadding = PaddingValues(horizontal = 12.dp, vertical = 6.dp)
            ) {
                Text(
                    text = "$cost 🪙",
                    fontWeight = FontWeight.Bold,
                    fontSize = 12.sp
                )
            }
        }
    }
}
